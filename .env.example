# SQLite (local dev — no installation needed)
DATABASE_URL=sqlite+aiosqlite:///./deadswitch.db
# PostgreSQL (production) — uncomment and fill when ready:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/deadswitch
REDIS_URL=redis://localhost:6379/0

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/callback

JWT_SECRET=change-me-to-a-long-random-secret
JWT_ACCESS_TTL_MIN=15
JWT_REFRESH_TTL_DAYS=30

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FERNET_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=your-email@gmail.com

OTP_TTL_SECONDS=300
OTP_REQUEST_LIMIT=3
OTP_REQUEST_WINDOW_SEC=600
OTP_VERIFY_ATTEMPT_LIMIT=5

# False locally (Memurai, no proxy). True only on Render/Railway/nginx.
TRUST_PROXY_HEADERS=False

MAX_SWITCHES_PER_USER=5
APP_ENV=development
